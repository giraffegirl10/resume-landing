---
import { getEntry, getCollection } from 'astro:content';
import Project from '../components/Project.astro';
import '../styles/theme.css';
import '../styles/global.css';

const entry = await getEntry('profile', 'profile');
if (!entry) throw new Error('Add src/content/profile.yaml before building the portfolio.');
const profile = entry.data;
const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const title = `${profile.name} | Developer`;
const handle = profile.name.toLowerCase().split(/\s+/).join('.');
const [firstName, ...otherNames] = profile.name.split(' ');
const certification = profile.certifications[0];
const certShort = certification && `${certification.issuer} ${certification.name.match(/\(([^)]+)\)/)?.[1] ?? certification.name}`;
const variableName = (category: string) => category.split(/\W/)[0].toLowerCase();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.introduction} />
    <meta name="theme-color" content="#1a1a2e" />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.introduction} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wrap page">
      <header class="site-header">
        <a class="wordmark" href="#" aria-label={`${profile.name}, home`}><span class="monogram" aria-hidden="true">~$</span><span>{handle}</span></a>
        <nav aria-label="Main navigation">
          <a href="#projects">./projects</a><a href="#about">./about</a>{profile.blog && <a href={profile.blog}>./blog <span aria-hidden="true">↗</span></a>}<a class="nav-cta" href="#contact">./contact</a>
        </nav>
      </header>
      <main id="main" class="page" style="padding: 0">
        <section class="row" aria-labelledby="intro-title">
          <div class="hero-main tile tile-dark">
            <div>
              <p class="prompt">$ whoami <span>→ developer, cs student</span></p>
              <h1 id="intro-title">{firstName}<br />{otherNames.join(' ')}<span class="cursor" aria-hidden="true"></span></h1>
              <p class="intro">{profile.introduction}</p>
            </div>
            <div class="row" style="gap: .75rem">
              <a class="pill pill-accent" href="#projects">Explore my work <span aria-hidden="true">↓</span></a>
              <a class="pill pill-outline" href={profile.resume} download style="border-color: rgba(255,255,255,.35)">resume.pdf <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <div class="hero-side">
            <aside class="tile code-tile" aria-label="Education at a glance" style="flex: 1 1 auto">
              <div class="code-bar" aria-hidden="true"><span>profile.json</span><span>utf-8</span></div>
              <div class="code-body">
                <div class="muted">{'{'}</div>
                <div class="indent"><span class="code-key">"school"</span>: <span class="code-string">"{profile.education.school}"</span>,</div>
                <div class="indent"><span class="code-key">"degree"</span>: <span class="code-string">"{profile.education.degree}"</span>,</div>
                <div class="indent"><span class="code-key">"gpa"</span>: <span class="code-num">{profile.education.gpa}</span></div>
                <div class="muted">{'}'}</div>
              </div>
            </aside>
            <div class="stat-row">
              <div class="tile stat stat-yellow"><p>graduating</p><p>{profile.education.graduation.replace(/^Expected\s+/i, '')}</p></div>
              {certShort && <div class="tile stat stat-lavender"><p>certified</p><p>{certShort}</p></div>}
            </div>
          </div>
        </section>

        <section class="section" id="projects" aria-labelledby="work-title">
          <div class="section-heading">
            <div><p class="comment">// 01 — ideas into applications</p><h2 id="work-title">Selected work</h2></div>
            <span class="comment">ls projects/ — {projects.length} items</span>
          </div>
          {projects.map((project, index) => <Project project={project} index={index} />)}
        </section>

        <section class="section" id="about" aria-labelledby="about-title">
          <div class="section-heading">
            <div><p class="comment">// 02 — a little background</p><h2 id="about-title">Beyond the code</h2></div>
          </div>
          <div class="row">
            <div class="tile about-copy"><p>{profile.about}</p></div>
            {profile.experience.map((job) => (
              <article class="tile job">
                <p class="label">experience</p>
                <h3>{job.company}</h3>
                <p class="job-role">{job.role} · {job.location} · {job.dates}</p>
                <ul>{job.contributions.map((item) => <li>{item}</li>)}</ul>
              </article>
            ))}
          </div>
          <div class="tile tile-dark skills-tile">
            <div class="code-bar" aria-hidden="true"><span>skills.py</span><span>python</span></div>
            <div class="code-body">
              {profile.skills.map((group) => (
                <div><span class="code-key" title={group.category}>{variableName(group.category)}</span> = <span class="code-string">[{group.items.map((item) => `"${item}"`).join(', ')}]</span></div>
              ))}
            </div>
          </div>
        </section>

        <section class="tile tile-dark contact" id="contact" aria-labelledby="contact-title">
          <div>
            <p class="comment">// 03 — get in touch</p>
            <h2 id="contact-title">Let’s connect.</h2>
            <a class="email-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
          </div>
          <div class="row" style="gap: .75rem">
            <a class="pill pill-ghost" href={profile.github}>github <span aria-hidden="true">↗</span></a>
            <a class="pill pill-ghost" href={profile.linkedin}>linkedin <span aria-hidden="true">↗</span></a>
            <a class="pill pill-accent" href={profile.resume} download>resume.pdf <span aria-hidden="true">↓</span></a>
          </div>
        </section>
      </main>
      <footer><p>© {new Date().getFullYear()} {profile.name}</p><a href="#">cd ~ <span aria-hidden="true">↑</span></a></footer>
    </div>
  </body>
</html>
