---
import { getEntry, getCollection } from 'astro:content';
import Project from '../components/Project.astro';
import '../styles/theme.css';
import '../styles/global.css';

const entry = await getEntry('profile', 'profile');
if (!entry) throw new Error('Add src/content/profile.yaml before building the portfolio.');
const profile = entry.data;
const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const title = `${profile.name} | Developer`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.introduction} />
    <meta name="theme-color" content="#204c3d" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.introduction} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="#" aria-label={`${profile.name}, home`}><span class="monogram">{profile.initials}</span><span>{profile.name}</span></a>
      <nav aria-label="Main navigation">
        <a href="#projects">Projects</a><a href="#about">About</a><a href="#contact">Contact <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="intro-title">
        <div class="hero-main">
          <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span> {profile.name} / Developer</p>
          <h1 id="intro-title">{profile.headline}</h1>
          <p class="intro">{profile.introduction}</p>
          <div class="hero-actions"><a class="button" href="#projects">Explore my work <span aria-hidden="true">↓</span></a><a class="text-link" href={profile.resume} download>Download resume <span aria-hidden="true">↗</span></a></div>
        </div>
        <aside class="hero-note" aria-label="Education at a glance">
          <span class="note-mark" aria-hidden="true">{profile.initials}<span>.</span></span>
          <div><p class="eyebrow">Currently</p><p>{profile.education.degree}</p><p class="muted">{profile.education.school}</p></div>
          <p class="note-footer">{profile.education.graduation}</p>
        </aside>
      </section>
      <section class="work-section" id="projects" aria-labelledby="work-title">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">Ideas into applications</p><h2 id="work-title">Selected work<span class="accent">.</span></h2></div><span class="metadata">{String(projects.length).padStart(2, '0')} projects</span></div>
          {projects.map((project, index) => <Project project={project} index={index} />)}
        </div>
      </section>
      <section class="about-section wrap" id="about" aria-labelledby="about-title">
        <div class="section-heading"><div><p class="eyebrow">A little background</p><h2 id="about-title">Beyond the code<span class="accent">.</span></h2></div></div>
        <div class="about-grid">
          <div><p class="about-copy">{profile.about}</p><div class="skills">{profile.skills.map((group) => <div class="skill-group"><h3>{group.category}</h3><p>{group.items.join(' · ')}</p></div>)}</div></div>
          <div class="credentials"><section><h3 class="eyebrow">Education</h3><h4>{profile.education.school}</h4><p>{profile.education.degree}</p><p class="metadata">{profile.education.dates}</p><p class="metadata">GPA {profile.education.gpa} · {profile.education.graduation}</p></section>{profile.certifications.map((cert) => <section><h3 class="eyebrow">Certification</h3><h4>{cert.name}</h4><p class="metadata">{cert.issuer} · {cert.date}</p></section>)}</div>
        </div>
        <div class="experience"><h3 class="eyebrow">Experience</h3>{profile.experience.map((job) => <article class="experience-row"><div><h4>{job.company}</h4><p>{job.role} · {job.location}</p><p class="metadata">{job.dates}</p></div><div><p>{job.description}</p><ul>{job.contributions.map((item) => <li>{item}</li>)}</ul></div></article>)}</div>
      </section>
      <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="wrap contact-inner"><div><p class="eyebrow">Get in touch</p><h2 id="contact-title">Let’s connect.</h2><a class="email-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a></div><div class="social-links"><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a><a href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a><a href={profile.resume} download>Resume <span aria-hidden="true">↓</span></a></div></div></section>
    </main>
    <footer class="wrap"><p>© {new Date().getFullYear()} {profile.name}</p><a href="#">Back to top ↑</a></footer>
  </body>
</html>
